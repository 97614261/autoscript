<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#FCFCFF" android:endColor="#F0EAFF" />
        </shape>
    </item>
    <item android:width="192dp" android:height="192dp" android:gravity="center">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="96dp"
                android:startColor="#E5D1FF" android:endColor="#00F5F6FF" />
        </shape>
    </item>
    <item android:width="164dp" android:height="164dp" android:gravity="center">
        <bitmap android:src="@drawable/zhigou_brand_mark" android:gravity="fill" android:filter="true" />
    </item>
</layer-list>
