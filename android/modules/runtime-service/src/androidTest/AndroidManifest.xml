<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name="com.autoscript.runtime.service.QaInputMethodService"
            android:label="智构 QA 测试键盘"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/qa_input_method" />
        </service>
        <activity
            android:name="com.autoscript.runtime.service.ScriptUiAcceptanceActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    </application>
</manifest>
