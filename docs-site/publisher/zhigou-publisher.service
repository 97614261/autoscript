[Unit]
Description=Zhigou loopback APK publisher
After=network.target

[Service]
Type=simple
User=zhigou-publisher
Group=zhigou-publisher
ExecStart=/usr/bin/python3 /opt/zhigou-publisher/publish-server.py --data-dir /var/lib/zhigou-publisher --token-file /etc/zhigou-publisher/token --port 8765
WorkingDirectory=/opt/zhigou-publisher
StateDirectory=zhigou-publisher
StateDirectoryMode=0755
UMask=0022
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/zhigou-publisher
RestrictAddressFamilies=AF_INET AF_UNIX
CapabilityBoundingSet=
LockPersonality=true
LimitNOFILE=64
TasksMax=16
MemoryMax=192M

[Install]
WantedBy=multi-user.target
