{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/project/2/project.schema.json",
  "title": "AutoScript project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "flowSchemaVersion", "runtimeApi", "projectId", "name", "sourceMode", "flows", "capabilities", "design"],
  "properties": {
    "formatVersion": { "const": 2 },
    "flowSchemaVersion": { "const": 1 },
    "runtimeApi": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sourceMode": { "enum": ["lua", "visual"] },
    "entryPoint": { "type": "string", "const": "main.lua" },
    "entryFlowId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["flowId", "path", "rootBlockId", "params", "returns"],
        "properties": {
          "flowId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "path": {
            "type": "string",
            "maxLength": 83,
            "pattern": "^visual/flows/[A-Za-z0-9_\\u4E00-\\u9FFF-](?:[A-Za-z0-9_\\u4E00-\\u9FFF. -]{0,62}[A-Za-z0-9_\\u4E00-\\u9FFF-])?\\.jsonl$",
            "$comment": "单层固定目录；名称 1–64 字，允许字母、数字、_、-、CJK 汉字，. 和空格只能在中间。分组是编辑器的虚拟视图，不进入路径。与 flow-ir valid_flow_name 和 ProjectStore.isValidFlowName 保持一致。"
          },
          "rootBlockId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "params": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type", "required"],
              "properties": {
                "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
                "type": { "enum": ["boolean", "integer", "number", "string"] },
                "required": { "type": "boolean" }
              }
            }
          },
          "returns": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "nullable"],
                "properties": {
                  "type": { "enum": ["boolean", "integer", "number", "string"] },
                  "nullable": { "type": "boolean" }
                }
              }
            ]
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path"],
        "properties": {
          "kind": { "enum": ["image", "glyphDictionary"] },
          "path": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "scaleMode", "orientationPolicy"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 32768 },
        "height": { "type": "integer", "minimum": 1, "maximum": 32768 },
        "scaleMode": { "enum": ["letterbox", "crop", "stretch"] },
        "orientationPolicy": { "enum": ["follow", "portrait", "landscape"] }
      }
    },
    "runnerUi": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "fields"],
          "properties": {
            "description": { "type": ["string", "null"], "maxLength": 512 },
            "fields": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": { "$ref": "#/$defs/runnerUiField" }
            }
          }
        }
      ]
    },
    "ownerId": { "type": ["string", "null"] },
    "cloudId": { "type": ["string", "null"] },
    "syncState": { "type": ["string", "null"] },
    "signature": { "type": ["object", "null"] },
    "licensePolicy": { "type": ["object", "null"] }
  },
  "$defs": {
    "runnerUiField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "required", "initialValue", "minimum", "maximum", "options"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 64 },
        "kind": { "enum": ["text", "integer", "boolean", "choice"] },
        "required": { "type": "boolean" },
        "initialValue": { "type": ["string", "integer", "boolean"] },
        "minimum": { "type": ["integer", "null"] },
        "maximum": { "type": ["integer", "null"] },
        "options": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "text" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "initialValue": { "type": "string", "maxLength": 256 },
              "minimum": { "type": "null" },
              "maximum": { "type": "null" },
              "options": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "integer" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "initialValue": { "type": "integer" },
              "options": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "boolean" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "initialValue": { "type": "boolean" },
              "minimum": { "type": "null" },
              "maximum": { "type": "null" },
              "options": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "choice" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "initialValue": { "type": "string" },
              "minimum": { "type": "null" },
              "maximum": { "type": "null" },
              "options": { "minItems": 1 }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "sourceMode": { "const": "lua" } }, "required": ["sourceMode"] },
      "then": {
        "required": ["entryPoint"],
        "properties": { "flows": { "maxItems": 0 } },
        "not": { "required": ["entryFlowId"] }
      }
    },
    {
      "if": { "properties": { "sourceMode": { "const": "visual" } }, "required": ["sourceMode"] },
      "then": {
        "required": ["entryFlowId"],
        "properties": { "flows": { "minItems": 1 } },
        "not": { "required": ["entryPoint"] }
      }
    }
  ]
}
