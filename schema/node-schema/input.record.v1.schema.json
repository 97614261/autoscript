{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/input.record/1/input.record.schema.json",
  "title": "录制全局动作",
  "type": "object",
  "required": [
    "kind",
    "nodeVersion",
    "args"
  ],
  "properties": {
    "kind": {
      "const": "input.record"
    },
    "nodeVersion": {
      "const": 1
    },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "durationMs",
        "eventBudget",
        "resultVariable"
      ],
      "properties": {
        "durationMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000
        },
        "eventBudget": {
          "type": "integer",
          "minimum": 128,
          "maximum": 512
        },
        "resultVariable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  }
}
