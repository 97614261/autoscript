{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/vision.findimage/1/vision.findimage.schema.json",
  "title": "vision.findimage node semantics",
  "type": "object",
  "required": ["kind", "nodeVersion", "args"],
  "properties": {
    "kind": { "const": "vision.findimage" },
    "nodeVersion": { "const": 1 },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frameVariable", "imagePath", "tolerance", "similarityPermille", "region", "foundVariable", "xVariable", "yVariable"],
      "properties": {
        "frameVariable": { "$ref": "#/$defs/variable" },
        "imagePath": { "type": "string", "pattern": "^assets/images/[^\\\\]+$", "maxLength": 256 },
        "tolerance": { "type": "integer", "minimum": 0, "maximum": 255 },
        "similarityPermille": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "region": { "$ref": "#/$defs/rect" },
        "foundVariable": { "$ref": "#/$defs/variable" },
        "xVariable": { "$ref": "#/$defs/variable" },
        "yVariable": { "$ref": "#/$defs/variable" }
      }
    }
  },
  "$defs": {
    "variable": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "top", "right", "bottom"],
      "properties": {
        "left": { "type": "integer" }, "top": { "type": "integer" },
        "right": { "type": "integer" }, "bottom": { "type": "integer" }
      }
    }
  }
}
