{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/math.round/1/math.round.schema.json",
  "title": "math.round node semantics",
  "type": "object",
  "required": [
    "kind",
    "nodeVersion",
    "args"
  ],
  "properties": {
    "kind": {
      "const": "math.round"
    },
    "nodeVersion": {
      "const": 1
    },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "resultVariable"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": -1000000000000,
          "maximum": 1000000000000
        },
        "valueVariable": {
          "$ref": "#/$defs/variable"
        },
        "resultVariable": {
          "$ref": "#/$defs/variable"
        }
      }
    }
  },
  "$defs": {
    "variable": {
      "type": "string",
      "pattern": "^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$"
    }
  }
}
