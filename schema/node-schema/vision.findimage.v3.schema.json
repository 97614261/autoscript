{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/vision.findimage/3/vision.findimage.schema.json",
  "title": "vision.findimage v3: optional success/failure branches",
  "type": "object",
  "required": [
    "kind",
    "nodeVersion",
    "args"
  ],
  "properties": {
    "kind": {
      "const": "vision.findimage"
    },
    "nodeVersion": {
      "const": 3
    },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frameVariable",
        "imagePath",
        "tolerance",
        "similarityPermille",
        "region",
        "foundVariable",
        "xVariable",
        "yVariable"
      ],
      "properties": {
        "frameVariable": {
          "$ref": "#/$defs/variable"
        },
        "imagePath": {
          "type": "string",
          "pattern": "^assets/images/[^\\\\]+$",
          "maxLength": 256
        },
        "imageDirectory": {
          "type": "string",
          "pattern": "^assets/images/([^\\\\]+/)?$",
          "maxLength": 256
        },
        "imagePaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        },
        "templateVariable": {
          "$ref": "#/$defs/variable"
        },
        "scoreVariable": {
          "$ref": "#/$defs/variable"
        },
        "imageVariable": {
          "$ref": "#/$defs/variable"
        },
        "frequency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "default": 1
        },
        "autoCapture": {
          "type": "boolean",
          "default": false
        },
        "successAction": {
          "enum": [
            "none",
            "tap",
            "hold",
            "tapWait",
            "pressRelease"
          ],
          "default": "none"
        },
        "offsetX": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "offsetY": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "actionDurationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "tolerance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "similarityPermille": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "region": {
          "$ref": "#/$defs/rect"
        },
        "direction": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "default": 0
        },
        "leftVariable": {
          "$ref": "#/$defs/variable"
        },
        "topVariable": {
          "$ref": "#/$defs/variable"
        },
        "rightVariable": {
          "$ref": "#/$defs/variable"
        },
        "bottomVariable": {
          "$ref": "#/$defs/variable"
        },
        "foundVariable": {
          "$ref": "#/$defs/variable"
        },
        "xVariable": {
          "$ref": "#/$defs/variable"
        },
        "yVariable": {
          "$ref": "#/$defs/variable"
        }
      }
    },
    "childBlocks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success",
        "failure"
      ],
      "properties": {
        "success": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "failure": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    }
  },
  "$defs": {
    "variable": {
      "type": "string",
      "pattern": "^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$"
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ],
      "properties": {
        "left": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "top": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "right": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "bottom": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    }
  }
}
