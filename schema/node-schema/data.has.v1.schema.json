{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/data.has/1/data.has.schema.json",
  "title": "data.has node semantics",
  "type": "object",
  "required": [
    "kind",
    "nodeVersion",
    "args"
  ],
  "properties": {
    "kind": {
      "const": "data.has"
    },
    "nodeVersion": {
      "const": 1
    },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "json",
        "key",
        "resultVariable"
      ],
      "properties": {
        "json": {
          "type": "string",
          "minLength": 0,
          "maxLength": 65536
        },
        "jsonVariable": {
          "$ref": "#/$defs/variable"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "keyVariable": {
          "$ref": "#/$defs/variable"
        },
        "resultVariable": {
          "$ref": "#/$defs/variable"
        }
      }
    }
  },
  "$defs": {
    "variable": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
    }
  }
}

