{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/vision.readresult/1/vision.readresult.schema.json",
  "title": "读取识别结果属性",
  "type": "object",
  "required": [
    "kind",
    "nodeVersion",
    "args"
  ],
  "properties": {
    "kind": {
      "const": "vision.readresult"
    },
    "nodeVersion": {
      "const": 1
    },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceVariable",
        "shape",
        "index",
        "field",
        "resultVariable"
      ],
      "properties": {
        "sourceVariable": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "resultVariable": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "shape": {
          "enum": [
            "IMAGES",
            "GLYPH_SUMMARY",
            "GLYPH_ITEM",
            "TEXT_ITEM",
            "COLORS",
            "COMPONENTS"
          ]
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2048
        },
        "field": {
          "enum": [
            "count",
            "truncated",
            "text",
            "coveragePermille",
            "averageScorePermille",
            "recognized",
            "score",
            "scorePermille",
            "x",
            "y",
            "width",
            "height",
            "path",
            "area",
            "left",
            "top",
            "right",
            "bottom",
            "centerX",
            "centerY"
          ]
        }
      }
    }
  }
}
