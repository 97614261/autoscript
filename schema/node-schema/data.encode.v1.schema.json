{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/data.encode/1/data.encode.schema.json",
  "title": "data.encode node semantics",
  "type": "object",
  "required": [
    "kind",
    "nodeVersion",
    "args"
  ],
  "properties": {
    "kind": {
      "const": "data.encode"
    },
    "nodeVersion": {
      "const": 1
    },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "mode",
        "resultVariable"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 0,
          "maxLength": 65536
        },
        "valueVariable": {
          "$ref": "#/$defs/variable"
        },
        "mode": {
          "type": "string",
          "minLength": 0,
          "maxLength": 8,
          "enum": [
            "text",
            "json"
          ]
        },
        "modeVariable": {
          "$ref": "#/$defs/variable"
        },
        "resultVariable": {
          "$ref": "#/$defs/variable"
        }
      }
    }
  },
  "$defs": {
    "variable": {
      "type": "string",
      "pattern": "^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$"
    }
  }
}
