{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/control.repeat/1/control.repeat.schema.json",
  "title": "control.repeat node semantics",
  "type": "object",
  "required": ["kind", "nodeVersion", "childBlocks", "args"],
  "properties": {
    "kind": { "const": "control.repeat" },
    "nodeVersion": { "const": 1 },
    "childBlocks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body"],
      "properties": {
        "body": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": ["times"],
      "properties": {
        "times": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "timesVariable": {"anyOf": [{"type": "string", "pattern": "^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$"}, {"type": "string", "pattern": "^=[\\s\\S]+$", "maxLength": 1025, "description": "运行时标量表达式；UTF-8最多1024字节，结果需匹配输入类型。"}]},
        "indexVariable": { "type": "string", "pattern": "^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$" },
        "elapsedVariable": { "type": "string", "pattern": "^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$" }
      }
    }
  }
}
