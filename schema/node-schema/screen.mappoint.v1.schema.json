{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://autoscript.local/schema/node/screen.mappoint/1/screen.mappoint.schema.json",
  "title":"还原原屏坐标","type":"object","required":["kind","nodeVersion","args"],
  "properties":{"kind":{"const":"screen.mappoint"},"nodeVersion":{"const":1},"args":{"type":"object","additionalProperties":false,
    "required":["frameVariable","x","y","xVariable","yVariable","resultVariable"],
    "properties":{"frameVariable":{"type":"string","pattern":"^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$"},"resultVariable":{"type":"string","pattern":"^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$"},
      "x":{"type":"integer","minimum":0,"maximum":32768},"y":{"type":"integer","minimum":0,"maximum":32768},"xVariable":{"anyOf": [{"type": "string", "pattern": "^([A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63})?$"}, {"type": "string", "pattern": "^=[\\s\\S]+$", "maxLength": 1025, "description": "运行时标量表达式；UTF-8最多1024字节，结果需匹配输入类型。"}]},"yVariable":{"anyOf": [{"type": "string", "pattern": "^([A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63})?$"}, {"type": "string", "pattern": "^=[\\s\\S]+$", "maxLength": 1025, "description": "运行时标量表达式；UTF-8最多1024字节，结果需匹配输入类型。"}]}}}}
}
