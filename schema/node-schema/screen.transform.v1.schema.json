{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/screen.transform/1/screen.transform.schema.json",
  "title": "图像变换",
  "type": "object",
  "required": [
    "kind",
    "nodeVersion",
    "args"
  ],
  "properties": {
    "kind": {
      "const": "screen.transform"
    },
    "nodeVersion": {
      "const": 1
    },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frameVariable",
        "mode",
        "width",
        "height",
        "resultVariable"
      ],
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "mask" } }, "required": ["mode"] },
          "then": { "required": ["mask"] },
          "else": { "not": { "required": ["mask"] } }
        },
        {
          "if": { "properties": { "mode": { "enum": ["despeckle","erode","dilate","open","close"] } }, "required": ["mode"] },
          "then": { "required": ["cleanup"] },
          "else": { "not": { "required": ["cleanup"] } }
        },
        {
          "if": { "properties": { "mode": { "const": "filter" } }, "required": ["mode"] },
          "then": { "required": ["filter"] },
          "else": { "not": { "required": ["filter"] } }
        }
      ],
      "properties": {
        "frameVariable": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$"
        },
        "mode": {
          "type": "string",
          "enum": [
            "rotate90",
            "rotate180",
            "rotate270",
            "flipX",
            "flipY",
            "gray",
            "threshold",
            "filter",
            "mask", "despeckle", "erode", "dilate", "open", "close",
            "resize"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194304
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194304
        },
        "threshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "default": 128
        },
        "filter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "mask": { "type": "string", "minLength": 1, "maxLength": 15000 },
        "cleanup": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "resultVariable": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$"
        }
      }
    }
  }
}
