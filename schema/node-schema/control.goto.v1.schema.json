{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/control.goto/1/control.goto.schema.json",
  "type": "object", "required": ["kind", "nodeVersion", "args"],
  "properties": { "kind": { "const": "control.goto" }, "nodeVersion": { "const": 1 },
    "args": { "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": { "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" } } } }
}
