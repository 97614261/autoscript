{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/task.message/1/task.message.schema.json",
  "title": "typed dynamic output",
  "type": "object", "required": ["kind", "nodeVersion", "args"],
  "properties": {
    "kind": {"const": "task.message"}, "nodeVersion": {"const": 1},
    "childBlocks": {"type": "object", "maxProperties": 0},
    "args": {"type": "object", "additionalProperties": false, "required": ["expression", "channel"],
      "properties": {
        "expression": {"type": "string", "minLength": 1, "maxLength": 1024},
        "channel": {"enum": ["popup", "output", "console"]}
      }
    }
  }
}
