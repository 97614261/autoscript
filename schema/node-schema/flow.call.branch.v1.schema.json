{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://autoscript.local/schema/node/flow.call.branch/1/flow.call.branch.schema.json",
  "type":"object","required":["kind","nodeVersion","args","childBlocks"],
  "properties":{
    "kind":{"const":"flow.call.branch"},"nodeVersion":{"const":1},
    "childBlocks":{"type":"object","additionalProperties":false,"required":["success","failure"],"properties":{"success":{"type":"string","minLength":1},"failure":{"type":"string","minLength":1}}},
    "args":{"type":"object","additionalProperties":false,"required":["targetFlowId","arguments"],"properties":{
      "targetFlowId":{"type":"string","minLength":1,"maxLength":128},
      "arguments":{"type":"object","additionalProperties":{"type":["boolean","integer","number","string","null"]}}
    }}
  }
}
