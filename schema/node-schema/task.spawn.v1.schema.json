{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/task.spawn/1/task.spawn.schema.json",
  "title": "task.spawn node semantics",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "kind",
    "nodeVersion",
    "args"
  ],
  "properties": {
    "kind": {
      "const": "task.spawn"
    },
    "nodeVersion": {
      "const": 1
    },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetFlowId",
        "arguments",
        "resultVariable"
      ],
      "properties": {
        "targetFlowId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "arguments": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "boolean",
              "integer",
              "number",
              "string",
              "null"
            ]
          }
        },
        "resultVariable": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        }
      }
    }
  }
}
