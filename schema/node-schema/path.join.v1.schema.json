{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/path.join/1/path.join.schema.json",
  "title": "path.join node semantics",
  "type": "object",
  "required": [
    "kind",
    "nodeVersion",
    "args"
  ],
  "properties": {
    "kind": {
      "const": "path.join"
    },
    "nodeVersion": {
      "const": 1
    },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left",
        "right",
        "resultVariable"
      ],
      "properties": {
        "left": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256
        },
        "leftVariable": {
          "$ref": "#/$defs/variable"
        },
        "right": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256
        },
        "rightVariable": {
          "$ref": "#/$defs/variable"
        },
        "resultVariable": {
          "$ref": "#/$defs/variable"
        }
      }
    }
  },
  "$defs": {
    "variable": {
      "type": "string",
      "pattern": "^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$"
    }
  }
}
