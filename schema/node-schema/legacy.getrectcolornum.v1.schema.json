{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/legacy.getrectcolornum/1/legacy.getrectcolornum.schema.json",
  "title": "legacy.getrectcolornum node semantics",
  "type": "object",
  "required": ["kind", "nodeVersion", "args"],
  "properties": {
    "kind": { "const": "legacy.getrectcolornum" },
    "nodeVersion": { "const": 1 },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frameVariable", "region", "colors", "resultVariable"],
      "properties": {
        "autoCapture": { "type": "boolean", "default": false, "description": "每次使用新截图，成功或普通错误后释放；不复用到下一次调用。启用需runtimeApi 1.8及screen.capture。" },
        "frameVariable": { "$ref": "#/$defs/variable" },
        "region": { "$ref": "#/$defs/legacyRegion" },
        "colors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/colorSpec" },
          "description": "命中任一颜色即计数一次。"
        },
        "resultVariable": { "$ref": "#/$defs/variable" }
      }
    }
  },
  "$defs": {
    "variable": { "type": "string", "pattern": "^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$" },
    "channelTolerance": { "type": "integer", "minimum": 0, "maximum": 255 },
    "colorSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rgb", "toleranceRed", "toleranceGreen", "toleranceBlue"],
      "properties": {
        "rgb": { "type": "integer", "minimum": 0, "maximum": 16777215 },
        "toleranceRed": { "$ref": "#/$defs/channelTolerance" },
        "toleranceGreen": { "$ref": "#/$defs/channelTolerance" },
        "toleranceBlue": { "$ref": "#/$defs/channelTolerance" }
      }
    },
    "legacyRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "top", "width", "height"],
      "properties": {
        "left": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "top": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "width": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "height": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
      }
    }
  }
}
