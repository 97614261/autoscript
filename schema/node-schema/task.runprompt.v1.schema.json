{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/task.runprompt/1/task.runprompt.schema.json",
  "title": "task.runprompt node semantics",
  "type": "object",
  "required": ["kind", "nodeVersion", "args"],
  "properties": {
    "kind": { "const": "task.runprompt" },
    "nodeVersion": { "const": 1 },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message"],
      "properties": {
        "message": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "valueVariable": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 64 }
      }
    }
  }
}
