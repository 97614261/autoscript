{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/screen.release/1/screen.release.schema.json",
  "title": "screen.release node semantics",
  "type": "object",
  "required": ["kind", "nodeVersion", "args"],
  "properties": {
    "kind": { "const": "screen.release" },
    "nodeVersion": { "const": 1 },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frameVariable"],
      "properties": {
        "frameVariable": { "type": "string", "pattern": "^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$" }
      }
    }
  }
}
