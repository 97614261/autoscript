{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/vision.findmulticolor/1/vision.findmulticolor.schema.json",
  "title": "vision.findmulticolor node semantics",
  "type": "object",
  "required": ["kind", "nodeVersion", "args"],
  "properties": {
    "kind": { "const": "vision.findmulticolor" },
    "nodeVersion": { "const": 1 },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frameVariable", "anchorRgb", "anchorTolerance", "samples", "region", "foundVariable", "xVariable", "yVariable"],
      "properties": {
        "frameVariable": { "$ref": "#/$defs/variable" },
        "anchorRgb": { "type": "integer", "minimum": 0, "maximum": 16777215 },
        "anchorTolerance": { "type": "integer", "minimum": 0, "maximum": 255 },
        "samples": {
          "type": "array", "minItems": 1, "maxItems": 64,
          "items": { "$ref": "#/$defs/sample" }
        },
        "region": { "$ref": "#/$defs/rect" },
        "foundVariable": { "$ref": "#/$defs/variable" },
        "xVariable": { "$ref": "#/$defs/variable" },
        "yVariable": { "$ref": "#/$defs/variable" }
      }
    }
  },
  "$defs": {
    "variable": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
    "sample": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y", "rgb", "tolerance"],
      "properties": {
        "x": { "type": "integer" }, "y": { "type": "integer" },
        "rgb": { "type": "integer", "minimum": 0, "maximum": 16777215 },
        "tolerance": { "type": "integer", "minimum": 0, "maximum": 255 }
      }
    },
    "rect": {
      "type": "object", "additionalProperties": false,
      "required": ["left", "top", "right", "bottom"],
      "properties": {
        "left": { "type": "integer" }, "top": { "type": "integer" },
        "right": { "type": "integer" }, "bottom": { "type": "integer" }
      }
    }
  }
}
