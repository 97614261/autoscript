{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/variable.copy/1/variable.copy.schema.json",
  "title": "variable.copy node semantics",
  "type": "object",
  "required": ["kind", "nodeVersion", "args"],
  "properties": {
    "kind": { "const": "variable.copy" },
    "nodeVersion": { "const": 1 },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sourceName"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
        "sourceName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" }
      }
    }
  }
}
