{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/vision.findfeatures/1/vision.findfeatures.schema.json",
  "title": "vision.findfeatures node semantics",
  "type": "object",
  "required": [
    "kind",
    "nodeVersion",
    "args"
  ],
  "properties": {
    "kind": {
      "const": "vision.findfeatures"
    },
    "nodeVersion": {
      "const": 1
    },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frameVariable",
        "imagePath",
        "left",
        "top",
        "right",
        "bottom",
        "minimumScorePermille",
        "resultVariable"
      ],
      "properties": {
        "frameVariable": {
          "$ref": "#/$defs/variable"
        },
        "imagePath": {
          "type": "string", "minLength": 1, "maxLength": 256
        },
        "left": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768
        },
        "top": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768
        },
        "right": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768
        },
        "bottom": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768
        },
        "minimumScorePermille": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "resultVariable": {
          "$ref": "#/$defs/variable"
        }
      }
    }
  },
  "$defs": {
    "variable": {
      "type": "string",
      "pattern": "^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$"
    }
  }
}
