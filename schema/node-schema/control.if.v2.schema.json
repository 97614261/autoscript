{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/control.if/2/control.if.schema.json",
  "title": "control.if node semantics",
  "type": "object",
  "required": [
    "kind",
    "nodeVersion",
    "childBlocks",
    "args"
  ],
  "properties": {
    "kind": {
      "const": "control.if"
    },
    "nodeVersion": {
      "const": 2
    },
    "childBlocks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "then",
        "else"
      ],
      "patternProperties": {
        "^elseIf[0-9]+$": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "properties": {
        "then": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "else": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "args": {
      "$ref": "#/$defs/comparison"
    }
  },
  "$defs": {
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variable",
        "operator",
        "value"
      ],
      "properties": {
        "variable": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "operator": {
          "enum": [
            "equals",
            "notEquals",
            "lessThan",
            "lessOrEqual",
            "greaterThan",
            "greaterOrEqual"
          ]
        },
        "value": {
          "type": [
            "boolean",
            "number",
            "string",
            "null"
          ]
        },
        "valueVariable": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "elseIf": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "variable",
              "operator",
              "value"
            ],
            "properties": {
              "variable": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
              },
              "operator": {
                "enum": [
                  "equals",
                  "notEquals",
                  "lessThan",
                  "lessOrEqual",
                  "greaterThan",
                  "greaterOrEqual"
                ]
              },
              "value": {
                "type": [
                  "boolean",
                  "number",
                  "string",
                  "null"
                ]
              },
              "valueVariable": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
              },
              "condition": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        "condition": {
          "$ref": "#/$defs/condition"
        }
      }
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "variable",
            "operator",
            "value"
          ],
          "properties": {
            "type": {
              "const": "compare"
            },
            "variable": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            },
            "operator": {
              "enum": [
                "equals",
                "notEquals",
                "lessThan",
                "lessOrEqual",
                "greaterThan",
                "greaterOrEqual"
              ]
            },
            "value": {
              "type": [
                "boolean",
                "number",
                "string",
                "null"
              ]
            },
            "valueVariable": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "conditions"
          ],
          "properties": {
            "type": {
              "enum": [
                "all",
                "any"
              ]
            },
            "conditions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "condition"
          ],
          "properties": {
            "type": {
              "const": "not"
            },
            "condition": {
              "$ref": "#/$defs/condition"
            }
          }
        }
      ]
    }
  }
}
