{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/math.randstr/1/math.randstr.schema.json",
  "title": "math.randstr node semantics",
  "type": "object",
  "required": [
    "kind",
    "nodeVersion",
    "args"
  ],
  "properties": {
    "kind": {
      "const": "math.randstr"
    },
    "nodeVersion": {
      "const": 1
    },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "length",
        "mode",
        "resultVariable"
      ],
      "properties": {
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "lengthVariable": {
          "$ref": "#/$defs/variable"
        },
        "mode": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "modeVariable": {
          "$ref": "#/$defs/variable"
        },
        "resultVariable": {
          "$ref": "#/$defs/variable"
        }
      }
    }
  },
  "$defs": {
    "variable": {
      "type": "string",
      "pattern": "^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$"
    }
  }
}
