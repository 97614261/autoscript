{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/control.loopcheck/1/control.loopcheck.schema.json",
  "title": "当前位置检测循环阈值并退出最近循环",
  "type": "object",
  "required": ["kind", "nodeVersion", "args"],
  "properties": {
    "kind": { "const": "control.loopcheck" }, "nodeVersion": { "const": 1 },
    "childBlocks": { "type": "object", "maxProperties": 0 },
    "args": {
      "type": "object", "additionalProperties": false, "required": ["metric", "limit"],
      "properties": {
        "metric": { "enum": ["count", "elapsed"] }, "limit": { "type": "number", "minimum": 0, "maximum": 86400000 },
        "limitVariable": {"anyOf": [{"type": "string", "pattern": "^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$"}, {"type": "string", "pattern": "^=[\\s\\S]+$", "maxLength": 1025, "description": "运行时标量表达式；UTF-8最多1024字节，结果需匹配输入类型。"}]},
        "unit": { "enum": ["milliseconds", "seconds", "minutes"], "default": "milliseconds" }
      }
    }
  }
}
