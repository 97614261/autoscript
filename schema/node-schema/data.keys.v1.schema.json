{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/data.keys/1/data.keys.schema.json",
  "title": "集合 / 对象键列表",
  "type": "object",
  "required": [
    "kind",
    "nodeVersion",
    "args"
  ],
  "properties": {
    "kind": {
      "const": "data.keys"
    },
    "nodeVersion": {
      "const": 1
    },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "json",
        "resultVariable"
      ],
      "properties": {
        "json": {
          "type": "string",
          "maxLength": 65536
        },
        "jsonVariable": {"anyOf": [{"type": "string", "maxLength": 64, "pattern": "^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$"}, {"type": "string", "pattern": "^=[\\s\\S]+$", "maxLength": 1025, "description": "运行时标量表达式；UTF-8最多1024字节，结果需匹配输入类型。"}]},
        "resultVariable": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$"
        }
      }
    }
  }
}
