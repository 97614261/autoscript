{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/files.kvremove/1/files.kvremove.schema.json",
  "title": "files.kvremove node semantics",
  "type": "object",
  "required": [
    "kind",
    "nodeVersion",
    "args"
  ],
  "properties": {
    "kind": {
      "const": "files.kvremove"
    },
    "nodeVersion": {
      "const": 1
    },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "key",
        "resultVariable"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "pathVariable": {
          "$ref": "#/$defs/variable"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "keyVariable": {
          "$ref": "#/$defs/variable"
        },
        "resultVariable": {
          "$ref": "#/$defs/variable"
        }
      }
    }
  },
  "$defs": {
    "variable": {
      "type": "string",
      "pattern": "^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$"
    }
  }
}

