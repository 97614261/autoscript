{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/floating.image/1/floating.image.schema.json",
  "title": "floating.image node semantics",
  "type": "object",
  "required": [
    "kind",
    "nodeVersion",
    "args"
  ],
  "properties": {
    "kind": {
      "const": "floating.image"
    },
    "nodeVersion": {
      "const": 1
    },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "imagePath",
        "x",
        "y",
        "width",
        "height",
        "draggable",
        "resultVariable"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "nameVariable": {
          "$ref": "#/$defs/variable"
        },
        "imagePath": {
          "type": "string"
        },
        "imagePathVariable": {
          "$ref": "#/$defs/variable"
        },
        "x": {
          "type": "integer"
        },
        "xVariable": {
          "$ref": "#/$defs/variable"
        },
        "y": {
          "type": "integer"
        },
        "yVariable": {
          "$ref": "#/$defs/variable"
        },
        "width": {
          "type": "integer"
        },
        "widthVariable": {
          "$ref": "#/$defs/variable"
        },
        "height": {
          "type": "integer"
        },
        "heightVariable": {
          "$ref": "#/$defs/variable"
        },
        "draggable": {
          "type": "integer"
        },
        "draggableVariable": {
          "$ref": "#/$defs/variable"
        },
        "resultVariable": {
          "$ref": "#/$defs/variable"
        }
      }
    }
  },
  "$defs": {
    "variable": {
      "type": "string",
      "pattern": "^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$"
    }
  }
}
