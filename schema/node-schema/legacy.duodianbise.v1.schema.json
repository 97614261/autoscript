{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/legacy.duodianbise/1/legacy.duodianbise.schema.json",
  "title": "legacy.duodianbise node semantics",
  "type": "object",
  "required": ["kind", "nodeVersion", "args"],
  "properties": {
    "kind": { "const": "legacy.duodianbise" },
    "nodeVersion": { "const": 1 },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frameVariable", "pattern", "minimumMatchPercent", "resultVariable"],
      "properties": {
        "frameVariable": { "$ref": "#/$defs/variable" },
        "pattern": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/fixedSample" },
          "description": "旧版绝对坐标比色点，坐标非负。"
        },
        "minimumMatchPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "resultVariable": { "$ref": "#/$defs/variable" }
      }
    }
  },
  "$defs": {
    "variable": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
    "channelTolerance": { "type": "integer", "minimum": 0, "maximum": 255 },
    "fixedSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "rgb", "toleranceRed", "toleranceGreen", "toleranceBlue"],
      "properties": {
        "x": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "y": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "rgb": { "type": "integer", "minimum": 0, "maximum": 16777215 },
        "toleranceRed": { "$ref": "#/$defs/channelTolerance" },
        "toleranceGreen": { "$ref": "#/$defs/channelTolerance" },
        "toleranceBlue": { "$ref": "#/$defs/channelTolerance" }
      }
    }
  }
}
