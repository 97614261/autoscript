{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/task.comment/1/task.comment.schema.json",
  "title": "task.comment node semantics",
  "type": "object",
  "required": ["kind", "nodeVersion", "args"],
  "properties": {
    "kind": { "const": "task.comment" },
    "nodeVersion": { "const": 1 },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message"],
      "properties": { "message": { "type": "string", "minLength": 1, "maxLength": 2048 } }
    }
  }
}
