{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://autoscript.local/schema/node/control.cycle/1/control.cycle.schema.json",
  "type":"object","required":["kind","nodeVersion","args","childBlocks"],
  "properties":{
    "kind":{"const":"control.cycle"},"nodeVersion":{"const":1},
    "childBlocks":{"type":"object","additionalProperties":false,"required":["body"],"properties":{"body":{"type":"string","minLength":1}}},
    "args":{"type":"object","additionalProperties":false,"required":["yieldMs"],"properties":{
      "yieldMs":{"type":"integer","minimum":1,"maximum":1000},
      "durationMs":{"type":"integer","minimum":1,"maximum":86400000},
      "durationVariable":{"type":"string","pattern":"^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$"},
      "durationUnit":{"enum":["milliseconds","seconds","minutes"]},
      "iterationVariable":{"type":"string","pattern":"^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$"},
      "elapsedVariable":{"type":"string","pattern":"^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$"}
    },"not":{"required":["durationMs","durationVariable"]}}
  }
}
