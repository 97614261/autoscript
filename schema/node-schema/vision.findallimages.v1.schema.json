{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/vision.findallimages/1/vision.findallimages.schema.json",
  "type": "object",
  "required": [
    "kind",
    "nodeVersion",
    "args",
    "childBlocks"
  ],
  "properties": {
    "kind": {
      "const": "vision.findallimages"
    },
    "nodeVersion": {
      "const": 1
    },
    "childBlocks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success",
        "failure"
      ],
      "properties": {
        "success": {
          "type": "string",
          "minLength": 1
        },
        "failure": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frameVariable",
        "autoCapture",
        "imagePaths",
        "tolerance",
        "similarityPermille",
        "region",
        "direction",
        "limit",
        "resultVariable"
      ],
      "properties": {
        "frameVariable": {
          "type": "string",
          "pattern": "^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$"
        },
        "autoCapture": {
          "type": "boolean"
        },
        "imagePaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        },
        "tolerance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "similarityPermille": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "direction": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "region": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "left",
            "top",
            "right",
            "bottom"
          ],
          "properties": {
            "left": {
              "type": "integer",
              "minimum": 0
            },
            "top": {
              "type": "integer",
              "minimum": 0
            },
            "right": {
              "type": "integer",
              "minimum": 1
            },
            "bottom": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "resultVariable": {
          "type": "string",
          "pattern": "^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$"
        },
        "successAction": {
          "enum": [
            "none",
            "tap",
            "hold",
            "tapWait",
            "pressRelease"
          ]
        },
        "allMatches": {
          "type": "boolean"
        },
        "offsetX": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "offsetY": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "actionDurationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "beforeWaitMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "afterWaitMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "successAction",
              "allMatches"
            ],
            "properties": {
              "successAction": {
                "const": "hold"
              },
              "allMatches": {
                "const": true
              }
            }
          },
          "then": {
            "not": {}
          }
        }
      ]
    }
  }
}
