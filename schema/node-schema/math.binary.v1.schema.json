{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/math.binary/1/math.binary.schema.json",
  "title": "math.binary node semantics",
  "type": "object",
  "required": [
    "kind",
    "nodeVersion",
    "args"
  ],
  "properties": {
    "kind": {
      "const": "math.binary"
    },
    "nodeVersion": {
      "const": 1
    },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "left",
        "right",
        "resultVariable"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16,
          "enum": [
            "min",
            "max",
            "pow",
            "atan2",
            "log"
          ]
        },
        "operationVariable": {
          "$ref": "#/$defs/variable"
        },
        "left": {
          "type": "number",
          "minimum": -1000000000000,
          "maximum": 1000000000000
        },
        "leftVariable": {
          "$ref": "#/$defs/variable"
        },
        "right": {
          "type": "number",
          "minimum": -1000000000000,
          "maximum": 1000000000000
        },
        "rightVariable": {
          "$ref": "#/$defs/variable"
        },
        "resultVariable": {
          "$ref": "#/$defs/variable"
        }
      }
    }
  },
  "$defs": {
    "variable": {
      "type": "string",
      "pattern": "^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$"
    }
  }
}
