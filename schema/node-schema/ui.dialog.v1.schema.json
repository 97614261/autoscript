{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/ui.dialog/1/ui.dialog.schema.json",
  "title": "布局对话框",
  "type": "object",
  "required": [
    "kind",
    "nodeVersion",
    "args"
  ],
  "properties": {
    "kind": {
      "const": "ui.dialog"
    },
    "nodeVersion": {
      "const": 1
    },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageId",
        "blockOutside",
        "timeoutMs"
      ],
      "properties": {
        "pageId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "blockOutside": {
          "type": "boolean"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 1800000
        },
        "resultVariable": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        }
      }
    }
  }
}
