{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/data.append/1/data.append.schema.json",
  "title": "追加集合标量",
  "type": "object",
  "required": [
    "kind",
    "nodeVersion",
    "args"
  ],
  "properties": {
    "kind": {
      "const": "data.append"
    },
    "nodeVersion": {
      "const": 1
    },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "json",
        "valueJson",
        "resultVariable"
      ],
      "properties": {
        "json": {
          "type": "string",
          "maxLength": 65536
        },
        "jsonVariable": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$"
        },
        "valueJson": {
          "type": "string",
          "maxLength": 65536
        },
        "valueJsonVariable": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$"
        },
        "resultVariable": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$"
        }
      }
    }
  }
}
