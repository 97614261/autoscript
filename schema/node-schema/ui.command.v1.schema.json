{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/node/ui.command/1/ui.command.schema.json",
  "title": "界面操作",
  "type": "object",
  "required": [
    "kind",
    "nodeVersion",
    "args"
  ],
  "properties": {
    "kind": {
      "const": "ui.command"
    },
    "nodeVersion": {
      "const": 1
    },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlId",
        "operation",
        "value"
      ],
      "properties": {
        "controlId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "operation": {
          "enum": [
            "backgroundImage", "get:backgroundImage", "groupVisible", "groupEnabled", "groupReset", "get:groupCount",
            "windowPosition", "bubblePosition", "get:windowPosition", "get:bubblePosition",
            "hint",
            "minimum",
            "maximum",
            "step",
            "range",
            "get:hint",
            "get:minimum",
            "get:maximum",
            "get:step",
            "get:config",
            "get:pages",
            "get:controls",
            "restoreConfig",
            "itemAdd",
            "itemInsert",
            "itemSet",
            "itemRemove",
            "itemsClear",
            "selectedIndex",
            "selectedIndices",
            "get:itemCount",
            "get:selectedIndex",
            "get:selectedIndices",
            "text",
            "visible",
            "enabled",
            "items",
            "progress",
            "page",
            "show",
            "hide",
            "minimize",
            "x", "y", "width", "height", "fontPx", "textColor", "background", "alignment",
            "fontBold", "textUnderline", "borderColor", "borderWidthPx", "cornerPx",
            "get:fontBold", "get:textUnderline", "get:borderColor", "get:borderWidthPx", "get:cornerPx",
            "get:x", "get:y", "get:width", "get:height", "get:fontPx", "get:textColor", "get:background", "get:alignment",
            "get:value", "get:text", "get:visible", "get:enabled", "get:items", "get:progress"
          ]
        },
        "value": {
          "type": "string",
          "maxLength": 8192
        },
        "valueVariable": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$"
        },
        "resultVariable": {
          "type": "string", "maxLength": 64, "pattern": "^[A-Za-z_\\u3400-\\u4DBF\\u4E00-\\u9FFF][A-Za-z0-9_\\u3400-\\u4DBF\\u4E00-\\u9FFF]{0,63}$"
        }
      }
    }
  }
}
