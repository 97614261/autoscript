{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/release/3/release.schema.json",
  "title": "AutoScript immutable Runner release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion", "releaseId", "projectId", "displayName", "applicationId",
    "versionCode", "versionName", "runtimeApi", "sourceMode", "capabilities", "design", "runnerUi", "lua", "sourceMap", "resources"
  ],
  "properties": {
    "formatVersion": { "const": 3 },
    "releaseId": { "$ref": "#/$defs/sha256" },
    "projectId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 128 },
    "applicationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "maxLength": 255
    },
    "versionCode": { "type": "integer", "minimum": 1, "maximum": 2100000000 },
    "versionName": { "type": "string", "minLength": 1, "maxLength": 64 },
    "runtimeApi": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "sourceMode": { "enum": ["lua", "visual"] },
    "capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "scaleMode", "orientationPolicy"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 32768 },
        "height": { "type": "integer", "minimum": 1, "maximum": 32768 },
        "scaleMode": { "enum": ["letterbox", "crop", "stretch"] },
        "orientationPolicy": { "enum": ["follow", "portrait", "landscape"] }
      }
    },
    "runnerUi": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "fields"],
          "properties": {
            "description": { "type": ["string", "null"], "maxLength": 512 },
            "fields": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": { "$ref": "#/$defs/runnerUiField" }
            }
          }
        }
      ]
    },
    "lua": { "$ref": "#/$defs/artifact" },
    "sourceMap": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/sourceMapArtifact" }
      ]
    },
    "resources": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "logicalPath", "bundlePath", "sha256", "size"],
        "properties": {
          "kind": { "enum": ["image", "glyphDictionary"] },
          "logicalPath": { "type": "string", "minLength": 1, "maxLength": 256 },
          "bundlePath": { "type": "string", "pattern": "^payload/[^\\\\]+$", "maxLength": 264 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "size": { "type": "integer", "minimum": 1, "maximum": 33554432 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "sourceMode": { "const": "lua" } }, "required": ["sourceMode"] },
      "then": { "properties": { "sourceMap": { "type": "null" } } }
    },
    {
      "if": { "properties": { "sourceMode": { "const": "visual" } }, "required": ["sourceMode"] },
      "then": { "properties": { "sourceMap": { "$ref": "#/$defs/sourceMapArtifact" } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": { "const": "payload/main.lua" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1, "maximum": 16777216 }
      }
    },
    "sourceMapArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": { "const": "payload/source-map.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1, "maximum": 8388608 }
      }
    },
    "runnerUiField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "required", "initialValue", "minimum", "maximum", "options"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 64 },
        "kind": { "enum": ["text", "integer", "boolean", "choice"] },
        "required": { "type": "boolean" },
        "initialValue": { "type": ["string", "integer", "boolean"] },
        "minimum": { "type": ["integer", "null"] },
        "maximum": { "type": ["integer", "null"] },
        "options": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "text" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "initialValue": { "type": "string", "maxLength": 256 },
              "minimum": { "type": "null" },
              "maximum": { "type": "null" },
              "options": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "integer" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "initialValue": { "type": "integer" },
              "options": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "boolean" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "initialValue": { "type": "boolean" },
              "minimum": { "type": "null" },
              "maximum": { "type": "null" },
              "options": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "choice" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "initialValue": { "type": "string" },
              "minimum": { "type": "null" },
              "maximum": { "type": "null" },
              "options": { "minItems": 1 }
            }
          }
        }
      ]
    }
  }
}
