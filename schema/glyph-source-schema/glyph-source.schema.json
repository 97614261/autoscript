{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schema/glyph-source/1/glyph-source.schema.json",
  "title": "AutoScript glyph maker source",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "glyphs"],
  "properties": {
    "formatVersion": { "const": 1 },
    "glyphs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 65535,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "rows"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 32 },
          "rows": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": { "type": "string", "pattern": "^[.#]{1,256}$" }
          }
        }
      }
    }
  }
}
