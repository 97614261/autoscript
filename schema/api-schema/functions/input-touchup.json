{
  "schemaVersion": 1,
  "opcode": 4015,
  "name": "Input.touchUp",
  "since": "1.8",
  "capability": "input.multi",
  "execution": "async_task",
  "cancelMode": "cooperative",
  "sideEffect": "device_input",
  "timeoutMs": 3000,
  "resourceOwnership": "task_pointer_lease",
  "summary": "释放指定的自有触点；已弹起且清理已确认时不发送重复输入，直接成功。其他任务仍不能代为释放。Root须明确协商多指支持，不支持时拒绝；停止、取消、过期及清理失败仍报错。",
  "params": [
    {
      "name": "pointerId",
      "type": "integer",
      "required": true,
      "summary": "触点编号0–4"
    }
  ],
  "returns": {
    "type": "integer",
    "nullable": false,
    "summary": "释放成功或已确认处于弹起状态时返回1；不代表目标App已处理。停止、取消、过期及触点清理失败仍报错。"
  },
  "legacyAliases": []
}
