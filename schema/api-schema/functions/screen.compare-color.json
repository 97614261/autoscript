{
  "schemaVersion": 1,
  "opcode": 5103,
  "name": "Screen.compareColor",
  "since": "1.4",
  "capability": "vision.pixel",
  "execution": "async_task",
  "cancelMode": "cooperative",
  "sideEffect": "none",
  "timeoutMs": 3000,
  "resourceOwnership": "borrowed_frame",
  "summary": "比较帧内一个像素与目标颜色是否落在逐通道容差内。",
  "params": [
    { "name": "frame", "type": "integer", "required": true, "summary": "任务持有的帧句柄。" },
    { "name": "x", "type": "integer", "required": true, "summary": "帧内横坐标。" },
    { "name": "y", "type": "integer", "required": true, "summary": "帧内纵坐标。" },
    { "name": "rgb", "type": "integer", "required": true, "summary": "0xRRGGBB目标颜色。" },
    { "name": "tolerance", "type": "integer", "required": true, "summary": "0至255的逐通道容差。" }
  ],
  "returns": { "type": "boolean", "nullable": false, "summary": "是否匹配。" },
  "legacyAliases": ["CompareColor"]
}
