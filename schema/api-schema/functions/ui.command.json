{
  "schemaVersion": 1,
  "opcode": 1203,
  "name": "UI.command",
  "since": "1.7",
  "capability": "ui.control",
  "execution": "host_sync",
  "cancelMode": "cooperative",
  "sideEffect": "ui_prompt",
  "timeoutMs": 3000,
  "resourceOwnership": "none",
  "summary": "白名单控件操作与属性读取。x/y/width/height/fontPx/borderWidthPx/cornerPx为设计像素；fontBold/textUnderline只接受true/false；textColor/background/borderColor为#AARRGGBB。get:属性返回真实字符串。新属性挂起等待宿主，旧写操作保留兼容提示队列。",
  "params": [
    {
      "name": "id",
      "type": "string",
      "required": true,
      "summary": "id"
    },
    {
      "name": "operation",
      "type": "string",
      "required": true,
      "summary": "operation"
    },
    {
      "name": "value",
      "type": "string",
      "required": true,
      "summary": "value"
    }
  ],
  "returns": {
    "type": "string",
    "nullable": true,
    "summary": "get:属性返回字符串；写入及窗口操作无返回值。宿主失败或超时抛出错误。"
  },
  "legacyAliases": []
}
