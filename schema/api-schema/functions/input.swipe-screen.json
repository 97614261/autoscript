      "type": "integer",
      "required": true,
      "summary": "起点Y。"
    },
    {
      "name": "x2",
      "type": "integer",
      "required": true,
      "summary": "终点X。"
    },
    {
      "name": "y2",
      "type": "integer",
      "required": true,
      "summary": "终点Y。"
    },
    {
