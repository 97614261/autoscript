{
  "schemaVersion": 1,
  "opcode": 5104,
  "name": "Screen.findMultiColor",
  "since": "1.4",
  "capability": "vision.pixel",
  "execution": "async_task",
  "cancelMode": "cooperative",
  "sideEffect": "none",
  "timeoutMs": 3000,
  "resourceOwnership": "borrowed_frame",
  "summary": "在半开ROI内按行优先查找锚点色和最多64个有符号偏移采样点。",
  "params": [
    { "name": "frame", "type": "integer", "required": true, "summary": "任务持有的帧句柄。" },
    { "name": "anchorRgb", "type": "integer", "required": true, "summary": "0xRRGGBB锚点颜色。" },
    { "name": "anchorTolerance", "type": "integer", "required": true, "summary": "锚点逐通道容差。" },
    { "name": "samples", "type": "MultiColorSample[]", "required": true, "summary": "附加采样点表；每项包含x、y、rgb、tolerance。" },
    { "name": "left", "type": "integer", "required": true, "summary": "ROI左边界，包含。" },
    { "name": "top", "type": "integer", "required": true, "summary": "ROI上边界，包含。" },
    { "name": "right", "type": "integer", "required": true, "summary": "ROI右边界，不包含。" },
    { "name": "bottom", "type": "integer", "required": true, "summary": "ROI下边界，不包含。" }
  ],
  "returns": { "type": "Point", "nullable": true, "summary": "首个匹配锚点；未找到时为nil。" },
  "legacyAliases": ["FindMultiColor"]
}
