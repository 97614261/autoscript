{
  "schemaVersion": 1,
  "kind": "vision.readresult",
  "nodeVersion": 1,
  "nodeSchemaId": "https://autoscript.local/schema/node/vision.readresult/1/vision.readresult.schema.json",
  "title": "读取识别结果属性",
  "category": "vision",
  "summary": "专用有界读取找图/OCR/颜色/连通块结果，不截图；缺失/越界/结构不匹配拒绝。recognized为1/0。",
  "searchTerms": [
    "结果",
    "OCR",
    "坐标",
    "数量",
    "中心点",
    "识别"
  ],
  "requiredCapabilities": [
    "core.task"
  ],
  "childBlocks": [],
  "migrations": [],
  "properties": [
    {
      "path": "sourceVariable",
      "label": "来源结果 · 字符变量",
      "editor": "string",
      "required": true,
      "defaultValue": ""
    },
    {
      "path": "shape",
      "label": "结果类型",
      "editor": "enum",
      "required": true,
      "defaultValue": "GLYPH_SUMMARY",
      "choices": [
        "IMAGES",
        "GLYPH_SUMMARY",
        "GLYPH_ITEM",
        "TEXT_ITEM",
        "COLORS",
        "COMPONENTS"
      ]
    },
    {
      "path": "index",
      "label": "序号 · 总览/数量为0",
      "editor": "integer",
      "required": true,
      "defaultValue": "0"
    },
    {
      "path": "field",
      "label": "属性",
      "editor": "enum",
      "required": true,
      "defaultValue": "count",
      "choices": [
        "count",
        "truncated",
        "text",
        "coveragePermille",
        "averageScorePermille",
        "recognized",
        "score",
        "scorePermille",
        "x",
        "y",
        "width",
        "height",
        "path",
        "area",
        "left",
        "top",
        "right",
        "bottom",
        "centerX",
        "centerY"
      ]
    },
    {
      "path": "resultVariable",
      "label": "接收变量 · 字符或整数",
      "editor": "string",
      "required": true,
      "defaultValue": ""
    }
  ]
}
