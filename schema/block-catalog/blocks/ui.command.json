        "minimum",
        "maximum",
        "step",
        "range",
        "get:hint",
        "get:minimum",
        "get:maximum",
        "get:step",
        "get:config",
        "get:pages",
        "get:controls",
        "restoreConfig",
        "itemAdd",
        "itemInsert",
        "itemSet",
        "itemRemove",
        "itemsClear",
        "selectedIndex",
        "selectedIndices",
        "get:itemCount",
        "get:selectedIndex",
        "get:selectedIndices",
        "text",
        "visible",
        "enabled",
        "items",
        "progress",
        "page",
        "show",
        "hide",
        "minimize",
        "x", "y", "width", "height", "fontPx", "textColor", "background", "alignment",
        "fontBold", "textUnderline", "borderColor", "borderWidthPx", "cornerPx",
        "get:fontBold", "get:textUnderline", "get:borderColor", "get:borderWidthPx", "get:cornerPx",
        "get:x", "get:y", "get:width", "get:height", "get:fontPx", "get:textColor", "get:background", "get:alignment",
        "get:value", "get:text", "get:visible", "get:enabled", "get:items", "get:progress"
      ]
    },
    {
      "path": "value",
      "label": "值（读取时留空；颜色#AARRGGBB；选项换行）",
      "editor": "string",
      "required": true,
      "defaultValue": "true"
