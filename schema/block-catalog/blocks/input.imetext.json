      "path": "text",
      "label": "待提交文字",
      "editor": "string",
      "required": true,
      "defaultValue": ""
    },
    {
      "path": "textVariable",
      "label": "待提交文字来源变量（可选）",
      "editor": "string",
      "required": false
    },
    {
      "path": "resultVariable",
      "label": "结果变量（整数）",
      "editor": "string",
      "required": true,
      "defaultValue": ""
    }
  ],
